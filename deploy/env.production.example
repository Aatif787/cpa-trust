# ==============================================================================
# Production environment for santosharoratrust.org
# On the VPS:  cp deploy/env.production.example .env.production
# .env.production is git-ignored; never commit real credentials.
# ==============================================================================

# Canonical site URL (baked into SEO metadata, sitemap and robots at BUILD time).
# Changing it requires `./deploy/deploy.sh` (rebuild), not just a restart.
NEXT_PUBLIC_SITE_URL=https://santosharoratrust.org

# ------------------------------------------------------------------------------
# Contact form (SMTP) — intentionally left blank for now.
# While these are empty the site works normally; the contact form API replies
# "503 temporarily unavailable" instead of sending mail.
#
# To enable later: fill these in, then run
#   pm2 reload deploy/ecosystem.config.cjs --update-env
# (no rebuild needed — they are read at runtime).
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO_EMAIL=
SMTP_SEND_AUTO_REPLY=true
