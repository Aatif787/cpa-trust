# ==============================================================================
# Hostinger SMTP Configuration (Server-Only — Never Expose with NEXT_PUBLIC_)
# Copy to .env.local for local development or configure in Hostinger hPanel.
# ==============================================================================

# Hostinger SMTP server hostname (e.g. obtained from Hostinger Email Accounts)
SMTP_HOST=your-hostinger-smtp-host

# SMTP port (465 for SSL/TLS or 587 for STARTTLS)
SMTP_PORT=465

# "true" for SSL/TLS (port 465), "false" for STARTTLS (port 587)
SMTP_SECURE=true

# Authenticated Hostinger email account username and password
SMTP_USER=your-email@yourdomain.org
SMTP_PASS=your-smtp-password

# Sender header (should use your authenticated domain/mailbox per SPF & DKIM)
SMTP_FROM="Santosh Arora Trust <your-email@yourdomain.org>"

# Trust mailbox receiving contact form notifications
CONTACT_TO_EMAIL=recipient@yourdomain.org

# Send visitor acknowledgement confirmation email ("true" by default if omitted)
SMTP_SEND_AUTO_REPLY=true

# Canonical production website URL for SEO metadata and sitemap generation
NEXT_PUBLIC_SITE_URL=https://yourdomain.org
